# TIGER RQ-VAE settings reported in Rajput et al. (NeurIPS 2023).

include "config/base.gin"

import genrec.data.amazon
import genrec.models.rqvae

# Paper: 20k epochs, batch 1024, Adagrad lr=0.4.
train.epochs = 20000
train.iterations = None
train.warmup_epochs = 0
train.learning_rate = 0.4
train.weight_decay = 0.0
train.batch_size = 1024
train.optimizer_name = "adagrad"
# TIGER was implemented in Google's stack.  Both TensorFlow and Optax Adagrad
# default to a 0.1 initial accumulator and 1e-7 epsilon; PyTorch defaults to
# 0.0/1e-10, which turns lr=0.4 into an approximately sign-sized first update
# and immediately collapses this RQ-VAE.
train.adagrad_initial_accumulator_value = 0.1
train.adagrad_eps = 1e-7
train.lr_schedule = "constant"

# Paper: 768 -> 512 -> 256 -> 128 -> 32, ReLU, 3x256 RQ codes.
train.vae_input_dim = 768
train.vae_n_cat_feats = 0
train.vae_hidden_dims = [512, 256, 128]
train.vae_embed_dim = 32
train.vae_codebook_size = 256
train.vae_codebook_normalize = False
train.vae_sim_vq = False
train.vae_n_layers = 3
train.mlp_activation = "relu"
train.mlp_bias = True
# The RQ-VAE loss reconstructs x directly; the paper does not project decoder
# output back to the unit sphere.  Keep normalization only in legacy configs.
train.decoder_normalize = False
train.vae_codebook_mode = %genrec.models.rqvae.QuantizeForwardMode.STE
train.vae_codebook_last_layer_mode = %genrec.models.rqvae.QuantizeForwardMode.STE
train.commitment_weight = 0.25
train.use_kmeans_init = True
train.kmeans_init_samples = 1024
train.min_codebook_usage = 0.8

# The main-paper tokenizer is fitted to the recommendation corpus. Its content
# sentence uses title, price, brand and category (not legacy salesRank).
train.dataset = @AmazonItemDataset
train.dataset_folder = "dataset/amazon"
train.encoder_model_name = %MODEL_HUB_SENTENCE_T5_XL
train.train_item_split = "all"
train.eval_item_split = "all"
AmazonItemDataset.split = "{split}"
AmazonItemDataset.item_text_format = "tiger_paper"

train.save_model_every = 1000
# The paper explicitly requires >=80% usage.  Usage can degrade long before the
# 20k-epoch endpoint, so evaluate densely and retain checkpoint_best_health.pt.
train.eval_every = 50
train.save_dir_root = "out/tiger/amazon/{split}/rqvae_paper_aligned"
train.do_eval = True
train.amp = False
train.split_batches = True
train.wandb_logging = False
train.wandb_project = "tiger_rqvae_paper_aligned_{split}"
