# Existing GenRec baseline under the same public optimizer/precision protocol.
# Tokenizer, head and capacity differ: this is not a single-module ablation.
train.model_name = 'rankmixer'
train.dataset_folder = 'dataset/criteo_x1/criteo_x1_7b681156'
train.save_dir_root = 'out/paper_only_20261112/runs/rankmixer_adagrad_control/criteo_x1/seed{seed}'
train.embedding_dim = 20
train.token_num = 15
train.token_dim = 30
train.num_blocks = 2
train.ffn_hidden = 30
train.tokenizer_hidden = 500
train.tokenizer_dropout = 0.1
train.optimizer_name = 'adagrad'
train.learning_rate = 0.01
train.embedding_learning_rate = 0.05
train.embedding_regularizer = 1e-5
train.batch_size = 4096
train.eval_batch_size = 4096
train.epochs = 100
train.patience = 2
train.reduce_lr_on_plateau = False
train.amp = True
train.mixed_precision_type = 'bf16'
